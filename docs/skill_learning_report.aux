\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Learned gains for PVC (top) and penoplex (bottom), produced by the same precision rule \eqref  {eq:precision} on each material's own demonstrations. The structure is consistent with cork (Fig.~\ref {fig:gains}) --- the depth axis is tracked stiffly and force is released --- while the stiffness magnitudes and profiles differ per material, so the controller expresses material-specific behaviour without any manual retuning.}}{22}{figure.2}\protected@file@percent }
\newlabel{fig:gains_other}{{2}{22}{Learned gains for PVC (top) and penoplex (bottom), produced by the same precision rule \eqref {eq:precision} on each material's own demonstrations. The structure is consistent with cork (Fig.~\ref {fig:gains}) --- the depth axis is tracked stiffly and force is released --- while the stiffness magnitudes and profiles differ per material, so the controller expresses material-specific behaviour without any manual retuning}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Controlled comparison of gain assignments on cork ($N_{\rm  seed}=12$ randomised-physics seeds, paired). Only the identified precision attains low cut-depth error; inverting or permuting the learned structure degrades it. Bars denote mean$\pm $std.}}{23}{figure.3}\protected@file@percent }
\newlabel{fig:variance_comparison}{{3}{23}{Controlled comparison of gain assignments on cork ($N_{\rm seed}=12$ randomised-physics seeds, paired). Only the identified precision attains low cut-depth error; inverting or permuting the learned structure degrades it. Bars denote mean$\pm $std}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Positive-power perturbation validation on cork. A known positive joint-power burst is injected before the torque projection. Without the tank (top row), $\dot  q^\top \tau $ exceeds the counterfactual budget for $12.0\%$ of the samples and reaches a maximum margin of $+5876$\,W. With the tank projection (middle) and with tank plus phase gating (bottom), the implemented inequality $\dot  q^\top \tau _{\rm  safe}-P_{\max }\le 0$ is satisfied for the whole run ($0.0\%$ violations). The red shading marks the perturbation window.}}{23}{figure.4}\protected@file@percent }
\newlabel{fig:pass_adv}{{4}{23}{Positive-power perturbation validation on cork. A known positive joint-power burst is injected before the torque projection. Without the tank (top row), $\dot q^\top \tau $ exceeds the counterfactual budget for $12.0\%$ of the samples and reaches a maximum margin of $+5876$\,W. With the tank projection (middle) and with tank plus phase gating (bottom), the implemented inequality $\dot q^\top \tau _{\rm safe}-P_{\max }\le 0$ is satisfied for the whole run ($0.0\%$ violations). The red shading marks the perturbation window}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Nominal stability and passivity diagnostics on cork. The left column shows tracking error and cut-depth error; the middle column shows the Lyapunov diagnostic and tank energy; the third column shows the implemented torque power budget $P_{\max }$ together with nominal and projected torque power; the right column shows the reconstructed Cartesian residual, used as a diagnostic rather than as the primary passivity proof.}}{24}{figure.5}\protected@file@percent }
\newlabel{fig:stab}{{5}{24}{Nominal stability and passivity diagnostics on cork. The left column shows tracking error and cut-depth error; the middle column shows the Lyapunov diagnostic and tank energy; the third column shows the implemented torque power budget $P_{\max }$ together with nominal and projected torque power; the right column shows the reconstructed Cartesian residual, used as a diagnostic rather than as the primary passivity proof}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Why a material model is needed. This matched cork comparison uses the same controller and toggles only the contact physics. Top row: rigid box-on-box contact over-reacts and follows the solver geometry rather than the demonstrated cutting plateau ($37.9$\,N force RMSE, $127.8$\,N peak, $9.9$\,mm depth RMSE). Bottom row: the identified cutting-force law produces the bounded material plateau and tracks the demonstrated force ($3.9$\,N force RMSE, $58.8$\,N peak, $2.3$\,mm depth RMSE).}}{24}{figure.6}\protected@file@percent }
\newlabel{fig:before_after}{{6}{24}{Why a material model is needed. This matched cork comparison uses the same controller and toggles only the contact physics. Top row: rigid box-on-box contact over-reacts and follows the solver geometry rather than the demonstrated cutting plateau ($37.9$\,N force RMSE, $127.8$\,N peak, $9.9$\,mm depth RMSE). Bottom row: the identified cutting-force law produces the bounded material plateau and tracks the demonstrated force ($3.9$\,N force RMSE, $58.8$\,N peak, $2.3$\,mm depth RMSE)}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Cutting with the identified material model on \textbf  {cork}. Left column: the measured contact-force magnitude (blue) follows the desired (dashed) for the whole cut, on static (top) and moving (bottom) workpieces. Right column: per-axis position error --- the cut-depth (Z) error stays $\approx 2$\,mm; the lateral (Y) error peaks during the large demonstrated lateral swing.}}{25}{figure.7}\protected@file@percent }
\newlabel{fig:calibrated}{{7}{25}{Cutting with the identified material model on \textbf {cork}. Left column: the measured contact-force magnitude (blue) follows the desired (dashed) for the whole cut, on static (top) and moving (bottom) workpieces. Right column: per-axis position error --- the cut-depth (Z) error stays $\approx 2$\,mm; the lateral (Y) error peaks during the large demonstrated lateral swing}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Force tracking on \textbf  {PVC} (top) and \textbf  {penoplex} (bottom), static (left) and moving (right). The measured force (blue) follows each material's demonstrated level (dashed) to $\approx 2$\,N RMSE with $100\%$ contact. PVC plateaus highest ($\sim 86$\,N, hardest material), penoplex lowest ($\sim 63$\,N), mirroring the per-material cutting parameters of Table~\ref {tab:material}.}}{26}{figure.8}\protected@file@percent }
\newlabel{fig:calibrated_others}{{8}{26}{Force tracking on \textbf {PVC} (top) and \textbf {penoplex} (bottom), static (left) and moving (right). The measured force (blue) follows each material's demonstrated level (dashed) to $\approx 2$\,N RMSE with $100\%$ contact. PVC plateaus highest ($\sim 86$\,N, hardest material), penoplex lowest ($\sim 63$\,N), mirroring the per-material cutting parameters of Table~\ref {tab:material}}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Monitor snapshot reconstructed from one cork cutting episode ($1299$ controller samples, final phase $1.000$). The panels show Cartesian position (mm), material reaction force per axis (N, desired vs measured), commanded stiffness (kN/m), and position tracking error (mm) together with tank energy (J).}}{27}{figure.9}\protected@file@percent }
\newlabel{fig:monitor}{{9}{27}{Monitor snapshot reconstructed from one cork cutting episode ($1299$ controller samples, final phase $1.000$). The panels show Cartesian position (mm), material reaction force per axis (N, desired vs measured), commanded stiffness (kN/m), and position tracking error (mm) together with tank energy (J)}{figure.9}{}}
