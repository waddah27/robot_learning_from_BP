\@writefile{toc}{\contentsline {paragraph}{Ablation study: isolating the contribution of the learned variance structure.}{6}{section*.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces The identified precision attains the lowest cut-depth error on all $11$ stable seeds. Inverting or permuting the structure increases the error by $26$--$48\%$ ($p=0.001$, the smallest value attainable by the paired Wilcoxon test at this sample size). This isolates the identified \emph  {variance structure}, rather than gain adaptation in general, as the determinant of task performance.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:ablation}{{3}{6}{The identified precision attains the lowest cut-depth error on all $11$ stable seeds. Inverting or permuting the structure increases the error by $26$--$48\%$ ($p=0.001$, the smallest value attainable by the paired Wilcoxon test at this sample size). This isolates the identified \emph {variance structure}, rather than gain adaptation in general, as the determinant of task performance}{table.3}{}}
